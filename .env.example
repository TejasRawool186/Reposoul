# REPOSOUL — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# ─────────────────────────────────────────────
# GitHub Authentication
# ─────────────────────────────────────────────

# Personal Access Token (public_repo scope for public repos; repo scope for private)
GITHUB_TOKEN=your_github_personal_access_token_here

# OAuth Token (alternative to GITHUB_TOKEN — use for GitHub Apps / enterprise OAuth)
# GITHUB_OAUTH_TOKEN=your_oauth_token_here

# Token type override (auto-detected from prefix; set only if auto-detection fails)
# GITHUB_TOKEN_TYPE=pat   # or: oauth
