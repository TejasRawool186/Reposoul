{
  "name": "reposoul",
  "version": "1.0.0",
  "description": "An AI-powered open-source resurrection workbench. Discover abandoned repositories, investigate their technical condition, and plan their revival.",
  "main": "dist/index.js",
  "bin": {
    "reposoul": "dist/cli.js",
    "reposoul-mcp": "dist/mcp/server.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'),p='dist'; if(fs.existsSync(p)) fs.rmSync(p,{recursive:true,force:true});\"",
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "watch": "nodemon --exec ts-node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "abandoned-repositories",
    "open-source-revival",
    "repository-analysis",
    "resurrection",
    "github",
    "developer-tools",
    "cli",
    "typescript",
    "ml-scoring",
    "tech-debt"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "axios": "^1.12.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.1",
    "dotenv": "^16.4.5",
    "ora": "^5.4.1"
  }
}
